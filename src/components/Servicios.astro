---
import ServicioCard from './ServicioCard.astro';
---

<section id="servicios">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow"><span class="dot"></span>Qué hacemos</span>
      <h2>Todo lo que tu proyecto necesita, en cualquier idioma</h2>
      <p>
        Traducción, interpretación y revisión con traductores nativos
        especializados por sector.
      </p>
    </div>

    <div class="services">
      <ServicioCard
        titulo="Traducción literaria"
        texto="Novelas, relatos y contenido editorial, cuidando el estilo y la voz del autor."
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 7c-2-2-5-2-8-1v13c3-1 6-1 8 1 2-2 5-2 8-1V6c-3-1-6-1-8 1z"></path>
          <path d="M12 7v13"></path>
        </svg>
      </ServicioCard>

      <ServicioCard
        titulo="Traducción turística"
        texto="Webs, folletos y guías que invitan a viajar, adaptados a cada destino."
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="4" y="7" width="16" height="13" rx="2"></rect>
          <path d="M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2"></path>
          <path d="M4 12h16"></path>
        </svg>
      </ServicioCard>

      <ServicioCard
        titulo="Localización web y software"
        texto="Adaptamos tu web, app o producto a cada mercado, cultura incluida."
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M3 12h18M12 3a14 14 0 010 18M12 3a14 14 0 000 18"></path>
        </svg>
      </ServicioCard>

      <ServicioCard
        titulo="Interpretación"
        texto="Simultánea, consecutiva y de enlace, en remoto o presencial."
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2a3 3 0 00-3 3v6a3 3 0 006 0V5a3 3 0 00-3-3z"></path>
          <path d="M19 10v1a7 7 0 01-14 0v-1M12 18v3M9 21h6"></path>
        </svg>
      </ServicioCard>

      <ServicioCard
        titulo="Revisión y corrección"
        texto="Revisión por un segundo traductor nativo para pulir cada detalle."
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 20h9"></path>
          <path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z"></path>
        </svg>
      </ServicioCard>

      <ServicioCard
        titulo="Otras muchas"
        texto="Jurada, técnica, científica, audiovisual... Cuéntanos tu proyecto y te decimos cómo ayudarte."
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 8v8M8 12h8"></path>
        </svg>
      </ServicioCard>
    </div>
  </div>
</section>

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 900px) {
    .services {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 680px) {
    .services {
      grid-template-columns: 1fr;
    }
  }
</style>
