---
import { empresa, PENDIENTE } from '../data/traduxia.js';
const d = empresa.direccion;
const conSede = d.calle !== PENDIENTE;
const mapaQuery = conSede
  ? encodeURIComponent(d.mapaQuery || `${d.calle} ${d.cp} ${d.localidad} ${d.provincia}`)
  : '';
---

<section id="ubicacion">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow"><span class="dot"></span>Dónde estamos</span>
      <h2>En el corazón de Córdoba</h2>
    </div>

    <div class="loc-grid">
      <div class="loc-info reveal">
        <div class="loc-line">
          {
            conSede ? (
              <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0118 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M3 12h18M12 3a14 14 0 010 18M12 3a14 14 0 000 18"></path>
              </svg>
            )
          }
          <div>
            <div class="k">{conSede ? 'DIRECCIÓN' : 'MODALIDAD'}</div>
            {
              conSede ? (
                <div class="v">{d.calle}<br />{d.cp} {d.localidad}, {d.provincia}</div>
              ) : (
                <div class="v">100% online, con clientes de toda España y fuera</div>
              )
            }
          </div>
        </div>

        <div class="loc-line">
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3 19.5 19.5 0 01-6-6 19.8 19.8 0 01-3-8.6A2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.4 1.8.7 2.7a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.4-1.2a2 2 0 012.1-.4c.9.3 1.8.6 2.7.7a2 2 0 011.7 2z"></path>
          </svg>
          <div>
            <div class="k">TELÉFONO</div>
            {
              empresa.telefono === PENDIENTE ? (
                <div class="v pending">{empresa.telefono}</div>
              ) : (
                <div class="v">
                  <a href={`tel:${empresa.telefono.replace(/\s+/g, '')}`}>
                    {empresa.telefono}
                  </a>
                </div>
              )
            }
          </div>
        </div>

        <div class="loc-line">
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="M3 7l9 6 9-6"></path>
          </svg>
          <div>
            <div class="k">EMAIL</div>
            <div class="v"><a href={`mailto:${empresa.email}`}>{empresa.email}</a></div>
          </div>
        </div>

        <div class="loc-line">
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 3"></path>
          </svg>
          <div>
            <div class="k">HORARIO</div>
            {
              empresa.horario === PENDIENTE ? (
                <div class="v pending">{empresa.horario}</div>
              ) : (
                <div class="v">{empresa.horario}</div>
              )
            }
          </div>
        </div>
      </div>

      {
        conSede ? (
          <div class="map reveal">
            <iframe
              title="Mapa de Traduxia Idiomas"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              src={`https://www.google.com/maps?q=${mapaQuery}&output=embed`}
            />
          </div>
        ) : (
          <div class="online reveal">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M3 12h18M12 3a14 14 0 010 18M12 3a14 14 0 000 18"></path>
            </svg>
            <p>Recibimos y entregamos todo por email o WhatsApp. Sin desplazamientos, sin esperas de oficina.</p>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .loc-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 40px;
    align-items: stretch;
  }
  .loc-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .loc-line {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .loc-line:last-of-type {
    border-bottom: none;
  }
  .loc-line svg {
    width: 22px;
    height: 22px;
    stroke: var(--brand-deep);
    fill: none;
    stroke-width: 1.7;
    flex: none;
    margin-top: 3px;
  }
  .loc-line .k {
    font-weight: 600;
    font-size: 0.82rem;
    color: var(--brand-deep);
    letter-spacing: 0.02em;
  }
  .loc-line .v {
    color: var(--muted);
    font-size: 1.02rem;
  }
  .loc-line .v a:hover {
    color: var(--brand-deep);
  }
  .pending {
    font-style: italic;
    opacity: 0.7;
  }
  .map {
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    min-height: 360px;
  }
  .map iframe {
    width: 100%;
    height: 100%;
    min-height: 360px;
    border: 0;
    display: block;
  }
  .online {
    border-radius: 24px;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    min-height: 360px;
    background: linear-gradient(135deg, var(--brand-soft) 0%, #fff 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    padding: 40px;
    text-align: center;
  }
  .online svg {
    width: 72px;
    height: 72px;
    stroke: var(--brand-deep);
    fill: none;
    stroke-width: 1.4;
  }
  .online p {
    color: var(--muted);
    max-width: 32ch;
  }

  @media (max-width: 900px) {
    .loc-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
