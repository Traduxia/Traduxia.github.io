---
// Carrusel de idiomas (sustituye a la galería de fotos del proyecto
// original: aquí no hay fotos de clientes, así que cada "slide" es una
// tarjeta tipográfica con el saludo en ese idioma).
const slides = [
  { idioma: 'Inglés', saludo: 'Hello', nota: 'Traducción técnica y legal', tono: '#8b5cf6' },
  { idioma: 'Francés', saludo: 'Bonjour', nota: 'Localización web', tono: '#7c3aed' },
  { idioma: 'Alemán', saludo: 'Hallo', nota: 'Traducción jurada', tono: '#9061f9' },
  { idioma: 'Chino', saludo: '你好', nota: 'Interpretación de enlace', tono: '#6d28d9' },
  { idioma: 'Árabe', saludo: 'مرحبا', nota: 'Revisión y corrección', tono: '#7e22ce' },
  { idioma: 'Portugués', saludo: 'Olá', nota: 'Traducción literaria', tono: '#8456e8' },
];
---

<section id="idiomas">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow"><span class="dot"></span>Idiomas y especialidades</span>
      <h2>Más de 30 idiomas, siempre con traductor nativo</h2>
      <p>
        Estos son solo algunos de los idiomas con los que trabajamos cada
        semana. Si el tuyo no está en la lista, pregúntanos de todas formas.
      </p>
    </div>

    <div
      class="carrusel reveal"
      role="group"
      aria-roledescription="carrusel"
      aria-label="Idiomas con los que trabajamos"
    >
      <ul class="car-track">
        {
          slides.map((s, i) => (
            <li class="slide">
              <figure>
                <div
                  class="art"
                  style={`background: linear-gradient(135deg, ${s.tono} 0%, #2a1b45 120%)`}
                  role="img"
                  aria-label={`Saludo en ${s.idioma}: ${s.saludo}`}
                >
                  <span class="saludo">{s.saludo}</span>
                </div>
                <figcaption>
                  <strong>{s.idioma}</strong>
                  <span>{s.nota}</span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>

      <div class="car-controles">
        <button
          type="button"
          class="car-nav prev"
          aria-label="Idioma anterior"
          data-dir="-1"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
        </button>

        <div class="car-dots" role="tablist" aria-label="Ir a un idioma">
          {
            slides.map((_, i) => (
              <button
                type="button"
                class="car-dot"
                role="tab"
                aria-label={`Ir al idioma ${i + 1}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                data-i={i}
              />
            ))
          }
        </div>

        <button
          type="button"
          class="car-nav next"
          aria-label="Idioma siguiente"
          data-dir="1"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .carrusel {
    position: relative;
  }
  .car-track {
    position: relative;
    list-style: none;
    display: flex;
    gap: 20px;
    overflow-x: auto;
    padding: 4px;
    margin: 0 -4px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .car-track::-webkit-scrollbar {
    display: none;
  }
  .slide {
    flex: 0 0 420px;
    max-width: 88vw;
  }
  figure {
    position: relative;
    margin: 0;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    background: var(--brand-soft);
  }
  .art {
    width: 100%;
    height: 380px;
    display: grid;
    place-items: center;
  }
  .art .saludo {
    font-family: var(--serif);
    font-size: clamp(2.6rem, 6vw, 3.6rem);
    color: #fff;
    text-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
  }
  figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 34px 20px 16px;
    color: #fff;
    background: linear-gradient(
      to top,
      rgba(42, 27, 69, 0.78),
      rgba(42, 27, 69, 0)
    );
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  figcaption strong {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.2rem;
  }
  figcaption span {
    font-size: 0.86rem;
    opacity: 0.9;
  }

  /* Flechas + puntos debajo del carrusel, en vez de flotando sobre las
     tarjetas: así nunca las tapan, sea cual sea el idioma que esté en pantalla. */
  .car-controles {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 22px;
  }
  .car-nav {
    flex: none;
    z-index: 3;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--brand-deep);
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: 0 10px 24px -12px rgba(43, 26, 66, 0.5);
    transition: transform 0.18s, background 0.2s;
  }
  .car-nav:hover {
    transform: translateY(-2px);
    background: var(--brand-soft);
  }
  .car-nav svg {
    width: 18px;
    height: 18px;
  }

  .car-dots {
    display: flex;
    justify-content: center;
    gap: 10px;
  }
  .car-dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border-radius: 50%;
    border: none;
    background: var(--line);
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }
  .car-dot[aria-selected='true'] {
    background: var(--brand);
    transform: scale(1.35);
  }

  @media (max-width: 700px) {
    .slide {
      flex-basis: 88vw;
    }
    .art {
      height: 320px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .car-track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  const carrusel = document.querySelector<HTMLElement>('#idiomas .carrusel');
  const track = carrusel?.querySelector<HTMLElement>('.car-track') ?? null;
  const slides = carrusel
    ? [...carrusel.querySelectorAll<HTMLElement>('.slide')]
    : [];

  if (carrusel && track && slides.length > 1) {
    const dots = [...carrusel.querySelectorAll<HTMLButtonElement>('.car-dot')];
    const navs = [...carrusel.querySelectorAll<HTMLButtonElement>('.car-nav')];
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');

    let actual = 0;

    const marcarDots = (i: number) => {
      dots.forEach((d, j) =>
        d.setAttribute('aria-selected', String(j === i))
      );
    };

    // Posición absoluta (no relativa al scroll actual) a la que hay que
    // llevar el track para centrar la tarjeta i, recortada a los límites
    // del track. Al no tener espaciadores al principio/final, la primera y
    // la última tarjeta no llegan a quedar 100% centradas: se quedan
    // pegadas al borde, y eso hay que calcularlo aquí en vez de con
    // `scrollBy` relativo (que se desincroniza justo en esos dos extremos).
    const max = () => track.scrollWidth - track.clientWidth;
    const objetivo = (i: number) => {
      const s = slides[i];
      const centrado = s.offsetLeft + s.offsetWidth / 2 - track.clientWidth / 2;
      return Math.max(0, Math.min(max(), centrado));
    };

    // Mientras dura el scroll suave lanzado por nosotros mismos (flechas o
    // puntos), el listener de más abajo no debe "corregir" nada: si lo hace
    // a medio camino (el scroll suave tarda varios frames en llegar), corta
    // la animación y la redirige a la tarjeta anterior en vez de a la pedida.
    let programado = false;
    let finProgramado = 0;

    const irA = (i: number, suave = true) => {
      actual = (i + slides.length) % slides.length;
      programado = true;
      clearTimeout(finProgramado);
      finProgramado = window.setTimeout(() => {
        programado = false;
      }, 700);
      track.scrollTo({
        left: objetivo(actual),
        behavior: suave && !mq.matches ? 'smooth' : 'auto',
      });
      marcarDots(actual);
    };

    navs.forEach((b) =>
      b.addEventListener('click', () => {
        irA(actual + Number(b.dataset.dir));
        reiniciarAuto();
      })
    );
    dots.forEach((d) =>
      d.addEventListener('click', () => {
        irA(Number(d.dataset.i));
        reiniciarAuto();
      })
    );

    // Tarjeta cuya posición objetivo está más cerca del scroll actual (en
    // vez de comparar centros visuales, que en los extremos da resultados
    // ambiguos).
    const indiceMasCercano = () => {
      let mejor = 0;
      let min = Infinity;
      slides.forEach((_, i) => {
        const d = Math.abs(objetivo(i) - track.scrollLeft);
        if (d < min) {
          min = d;
          mejor = i;
        }
      });
      return mejor;
    };

    // Al deslizar con el dedo: actualiza el dot y, al parar, encaja la tarjeta.
    let raf = 0;
    let finScroll = 0;
    track.addEventListener(
      'scroll',
      () => {
        if (programado) return;
        if (!raf) {
          raf = requestAnimationFrame(() => {
            raf = 0;
            actual = indiceMasCercano();
            marcarDots(actual);
          });
        }
        clearTimeout(finScroll);
        finScroll = window.setTimeout(() => {
          const destino = objetivo(actual);
          if (Math.abs(track.scrollLeft - destino) > 4) {
            track.scrollTo({ left: destino, behavior: mq.matches ? 'auto' : 'smooth' });
          }
        }, 140);
      },
      { passive: true }
    );

    // Autoplay (se pausa al interactuar, con foco, oculto o reduced-motion).
    let timer = 0;
    const parar = () => {
      if (timer) clearInterval(timer);
      timer = 0;
    };
    const arrancar = () => {
      if (mq.matches || timer || document.hidden) return;
      timer = window.setInterval(() => irA(actual + 1), 5500);
    };
    const reiniciarAuto = () => {
      parar();
      arrancar();
    };

    carrusel.addEventListener('pointerenter', parar);
    carrusel.addEventListener('pointerleave', arrancar);
    carrusel.addEventListener('focusin', parar);
    carrusel.addEventListener('focusout', arrancar);
    document.addEventListener('visibilitychange', () =>
      document.hidden ? parar() : arrancar()
    );
    mq.addEventListener?.('change', () => (mq.matches ? parar() : arrancar()));

    // Solo hace autoplay mientras el carrusel está en pantalla.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (e) => (e[0].isIntersecting ? arrancar() : parar()),
        { threshold: 0.25 }
      ).observe(carrusel);
    } else {
      arrancar();
    }
  }
</script>
